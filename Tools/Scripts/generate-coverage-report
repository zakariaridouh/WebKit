"""Turn LLVM raw profiles from an instrumented test run into a coverage report.
Build with --coverage and run the tests with --coverage-dir, or let webkit-coverage do all of it.
"""

import logging
import optparse
import os
import re
import sys

from concurrent.futures import ThreadPoolExecutor

from webkitpy.common.host import Host
from webkitpy.coverage_build_inventory import find_absent_files
from webkitpy.coverage_directory_index import write_directory_index, write_report
from webkitpy.coverage_export import (
    ExportError, FORMATS as EXPORT_FORMATS, export_trace, parse_formats)
from webkitpy.coverage_lcov import (
    PathCanonicalizer, canonicalize_lcov, parse_lcov, parse_lcov_source_files, project_totals,
    staged_equivalents_for_scope, third_party_copied_header_ignore_regexes, uncovered_regions)
from webkitpy.coverage_provenance import (
    add_trace_measurements, provenance_record, summary_lines, trace_comment, write_provenance)
from webkitpy.coverage_requirements import (
    INSTRUMENTED_PRODUCTS, KNOWN_PRODUCTS, TEST_SUPPORT_PRODUCTS, UNREPORTED_PROFILE_WRITERS,
    normalize_build_root, product_name)
from webkitpy.coverage_scope import CoverageScope
from webkitpy.coverage_suites import (
    SuiteSpecError, check_union_equals_combined, line_totals, log_union_check,
    merge_suite_profiles, parse_suite_specs, resolve_suites)
from webkitpy.coverage_thresholds import (
    COVERAGE_GATE_EXIT_CODE, GATED_METRICS, check_absolute_thresholds, destination_name,
    option_name, thresholds_from_options)
from webkitpy.llvm_profile_utils import (
    LLVMCov, UNREADABLE_RAW_PROFILE_LIMIT, claimed_profile_name_prefixes,
    collected_profiles_with_no_object, merge_coverage_profiles, objects_with_no_profile_data,
    partition_unclaimed_profiles, survey_instrumentation)
from webkitpy.port import configuration_options, platform_options

_log = logging.getLogger('generate-coverage-report')


# Compile-time opt-outs miss headers copied into the build directory (libwebrtc installs its
# under usr/local/include), so third-party code is also excluded at report time.
THIRD_PARTY_IGNORE_REGEXES = (
    'Source/ThirdParty/',
    '/usr/local/include/webrtc/',
    '/usr/local/include/libwebrtc/',
    '/ThirdParty/',
)

DEFAULT_IGNORE_REGEXES = (
    '/DerivedSources/',
    '/Applications/Xcode.app/',
    r'\.sdk/',
    '/usr/include/',
)

_EPILOG = """
--suite=NAME:PATH gives one test suite a line-coverage column of its own, so that a gap can be
attributed to the suite that should have closed it. Give each harness run its own
--coverage-dir and then name them:

  Tools/Scripts/run-webkit-tests --release --coverage --coverage-dir=/tmp/cov-layout
  Tools/Scripts/run-api-tests    --release --coverage --coverage-dir=/tmp/cov-api
  Tools/Scripts/generate-coverage-report --release --output-dir=/tmp/report \\
      --suite=layout:/tmp/cov-layout --suite=api:/tmp/cov-api

Separating the runs has to be asked for when they run: collected profiles are named after the
framework that wrote them and not after the run, so two runs that shared one --coverage-dir
cannot be told apart afterwards. This warns when it is given a directory that holds more than
one run's profiles, because the alternative is a silently mislabelled column.

The combined column is reported from the merge of the suites' profiles, so it is the union of
the lines they executed and not the sum -- a line two suites reach counts once -- and it is by
construction what a single merged profile produces. Every run checks that against the union of
the per-suite traces and says so.

--fail-under-lines, --fail-under-functions and --fail-under-branches gate on absolute
coverage. A report that is written but below the threshold exits {gate} rather than 1, so that
a bot can tell "coverage is too low" from "the tooling broke", and the report is written
either way, because the report is how somebody works out why the gate fired.

They are checked against the totals this report displays, which are NOT the TOTAL line in
summary.txt: llvm-cov counts a copied header once per framework that includes it, and counts each
template instantiation as a function while lcov's records are keyed by mangled name. Its line and
function figures therefore differ from the report's.

There is deliberately no --fail-under-regions: regions exist only in summary.txt, on that
other denominator, and lcov carries no region records to compute a comparable number from.
There is deliberately no bare --fail-under either. The four metrics sit far apart on a
full-suite run, so one flag meaning whichever of them the tool happened to pick would gate the
wrong thing without saying so.

--test-scope-file says which TESTS the profiles came from, and it changes what every number
here means. Adding tests can only turn a line from uncovered to covered, so for a run over part
of the suite a covered line is exact and an uncovered line is unknown. A selective report
therefore writes every total as `>= 41.30%`, marks its title, names the shortfall in test
counts, gets a -selective infix in its directory name and its trace filename, and fails
--fail-under-lines rather than gating on a lower bound over a whole-tree denominator. Use
--fail-under-patch in compare-coverage-reports instead: it is sound under selection, since a
line it calls covered really was executed.

Without the flag the report says full-suite. If the tests were in fact a subset, nothing here
can tell, and the percentages will be quoted as exact. webkit-coverage always passes it.
""".format(gate=COVERAGE_GATE_EXIT_CODE)


class _PreformattedEpilog(optparse.IndentedHelpFormatter):
    """optparse rewraps the epilog into one blob, and the paragraph breaks carry meaning."""

    def format_epilog(self, epilog):
        return epilog or ''


def resolve_source_scopes(scopes, source_root):
    """(absolute paths for --sources, the ones that do not exist). llvm-cov resolves a relative path against its own cwd."""
    resolved, missing = [], []
    for scope in scopes:
        if os.path.isabs(scope):
            path = os.path.normpath(scope)
        elif os.path.exists(scope):
            path = os.path.abspath(scope)
        else:
            path = os.path.normpath(os.path.join(source_root, scope))
        if not os.path.exists(path):
            missing.append(path)
        resolved.append(path)
    return resolved, missing


def is_under_any(path, prefixes):
    return any(path == prefix or path.startswith(prefix.rstrip('/') + os.sep)
               for prefix in prefixes)


def selected_products(products, available):
    """The entries of available that products names, or all of them when products is None. An empty string selects none."""
    if products is None:
        return list(available)
    wanted = [name for name in products.split(',') if name]
    return [entry for entry in available if product_name(entry) in wanted]


def instrumented_binary_paths(port, extra_objects, include_test_support, products=None):
    """Every instrumented Mach-O to pass to llvm-cov. One invocation must see all of them: per-binary reports double-count header-inline functions."""
    objects = []
    missing = []
    for relative in selected_products(products, INSTRUMENTED_PRODUCTS):
        path = port._build_path(*relative.split('/'))
        if os.path.exists(path):
            objects.append(path)
        else:
            missing.append(relative)
    if missing:
        # Warn rather than log: a missing product looks the same as one with no coverage.
        _log.warning('Not found in the build directory, so absent from the report: %s',
                     ', '.join(missing))

    skipped = []
    for relative in selected_products(products, TEST_SUPPORT_PRODUCTS):
        path = port._build_path(*relative.split('/'))
        if not os.path.exists(path):
            continue
        if include_test_support:
            objects.append(path)
        else:
            skipped.append(relative)
    if skipped:
        _log.info('Skipping test-support and tool binaries (pass --include-test-support to '
                  'include them): %s', ', '.join(skipped))

    for path in extra_objects:
        if not os.path.exists(path):
            raise RuntimeError('--object {} does not exist'.format(path))
        objects.append(path)

    return objects


def parse_args(args):
    parser = optparse.OptionParser(usage='%prog [options] --coverage-dir=DIR --output-dir=DIR',
                                   epilog=_EPILOG, formatter=_PreformattedEpilog())
    parser.add_options(platform_options())
    parser.add_options(configuration_options())
    # CMake keeps coverage products in their own directory (cmake-mac/Coverage), not in Release,
    # so default to a coverage build.
    parser.set_defaults(coverage=True)
    parser.add_option('--no-coverage-build', action='store_false', dest='coverage',
                      help='Report on a tree that is not a coverage build directory, e.g. an '
                           'Xcode build where --coverage does not move the products')
    parser.add_option('--coverage-dir', help='Directory holding the .profraw files from an instrumented test run')
    parser.add_option('--profdata', help='Report from an already-indexed profile instead of raw profiles. Use this '
                                         'when a run was sharded and the shards were merged incrementally, which is '
                                         'how a full-suite run avoids accumulating hundreds of GB of raw profiles')
    parser.add_option('--output-dir', help='Directory to write the report into')
    parser.add_option('--suite', action='append', default=[], metavar='NAME:PATH',
                      help='Report one test suite as a column of its own, from its own '
                           'profiles. PATH is a --coverage-dir from that suite\'s run, or an '
                           'already-indexed .profdata. Repeatable, and the combined column is '
                           'the union of all of them. See the note below')
    parser.add_option('--build-directory',
                      help='Path to the build directory, if not the default. Either the tree or '
                           'its configuration directory: the configuration is appended to '
                           'whatever is given, so .../WebKitBuild-Coverage/Release would '
                           'otherwise resolve to .../WebKitBuild-Coverage/Release/Release and '
                           'find no products at all')
    parser.add_option('--object', action='append', dest='extra_objects', default=[],
                      help='Additional instrumented binary to include (repeatable)')
    parser.add_option('--products', metavar='LIST',
                      help='Comma-separated list of the instrumented products to report on, out '
                           'of {}. Defaults to all of them. An empty list selects none, which '
                           'together with --object is how a tool that already knows its own '
                           "product's path asks for that one and nothing else".format(
                               ', '.join(product_name(entry) for entry in INSTRUMENTED_PRODUCTS)))
    parser.add_option('--sources', '--only', action='append', dest='sources', default=[],
                      metavar='PATH',
                      help='Report only on source under PATH, which may be a directory or a '
                           'single file, relative to the checkout root or absolute. Repeatable. '
                           'It scopes the numbers as well as the output, so the totals are the '
                           'scope\'s and not the project\'s, and the provenance record says so. '
                           'Pair it with --no-build-inventory for the fastest loop')
    parser.add_option('--path-equivalence', action='append', default=[], metavar='FROM,TO',
                      help='Passed through to llvm-cov, for reporting on a different machine than the '
                           'one that built. Note this only affects where llvm-cov looks for source text; '
                           'it does not rewrite the paths shown in the report (repeatable)')
    parser.add_option('--ignore-filename-regex', action='append', dest='ignore_regexes', default=[],
                      help='Additional exclusion regex, on top of the defaults (repeatable)')
    parser.add_option('--include-test-support', action='store_true', default=False,
                      help='Also report on instrumented test-support and tool binaries '
                           '(libWebCoreTestSupport, jsc, webpushd, adattributiond). Off by default '
                           'so their line counts stay out of the product denominator')
    parser.add_option('--include-third-party', action='store_true', default=False,
                      help='Report on Source/ThirdParty too. The code is already instrumented -- '
                           'libwebrtc and libANGLE both carry __llvm_prf sections and are linked into '
                           'WebCore -- so this only stops filtering it out, at the cost of a much '
                           'larger report')
    parser.add_option('--no-html', action='store_false', dest='html', default=True,
                      help='Skip the HTML report: the directory index and the per-file line views')
    parser.add_option('--no-regions', action='store_false', dest='regions', default=True,
                      help='Do not highlight the parts of a line that did not run. They come '
                           'from a second llvm-cov export, run alongside the first.')
    parser.add_option('--no-source-views', action='store_false', dest='source_views', default=True,
                      help='Write the directory index but not the per-file line views, which are '
                           'the largest and slowest part of the report. --no-html would drop the '
                           'index too')
    parser.add_option('--llvm-cov-html', action='store_true', default=False,
                      help="Also produce llvm-cov's own per-file HTML pages, in html/. They are "
                           'much larger than the line views this generates from the trace, and '
                           'add sub-line detail lcov cannot express, such as a region of a '
                           'covered line that never executed')
    parser.add_option('--show-instantiations', action='store_true', default=False,
                      help='Include per-template-instantiation sub-views in the llvm-cov HTML '
                           'pages, so this only does anything together with --llvm-cov-html. They '
                           'make template-heavy code much larger and do not change per-file line '
                           'coverage')
    parser.add_option('--no-lcov', action='store_false', dest='lcov', default=True,
                      help='Skip the lcov export')
    parser.add_option('--export', action='append', default=[], metavar='FORMAT[,FORMAT...]',
                      help='Also write the lcov trace in other tools\' formats, to export/ under the '
                           'output directory: {}, or all. Repeatable, or comma-separated. Every '
                           'number is the report\'s. A path is relative to the checkout when it '
                           'is inside it and absolute otherwise'.format(', '.join(EXPORT_FORMATS)))
    parser.add_option('--no-compress-lcov', action='store_false', dest='compress_lcov', default=True,
                      help='Write coverage.lcov instead of coverage.lcov.gz. The trace is gzipped '
                           'by default because it compresses very well, and every reader in this '
                           'toolchain detects gzip, so an uncompressed one is only needed by '
                           'other tools')
    parser.add_option('--no-build-inventory', action='store_false', dest='build_inventory',
                      default=True,
                      help='Do not work out which files this configuration never compiled. '
                           'That third state keeps those files visible rather than silently '
                           'absent, so this is only for a build directory whose intermediates '
                           'have been pruned')
    parser.add_option('--keep-raw-profiles', action='store_true', default=False,
                      help='Keep the .profraw files. They are deleted once indexed by default: the raw '
                           'format has no compatibility guarantees, so it should not be archived')
    for metric in GATED_METRICS:
        parser.add_option(option_name(metric), type='float', metavar='PERCENT',
                          dest=destination_name(metric),
                          help='Exit {} if {} coverage is below PERCENT. See the note below'.format(
                              COVERAGE_GATE_EXIT_CODE, metric))
    parser.add_option('--allow-profile-mismatch', action='store_true', default=False,
                      help='Report anyway when the profile does not match the binaries. The default '
                           'is to refuse, because the resulting numbers look plausible but are wrong')
    parser.add_option('--allow-unreadable-profiles', action='store_true', default=False,
                      help='Report from the readable remainder when more than {:.0f}%% of the raw '
                           'profiles cannot be read. The default is to refuse: llvm-profdata is '
                           'run with --failure-mode=all, which fails only if every input fails, so '
                           'a collection that mostly failed otherwise produces a confidently low '
                           'report and exit 0'.format(100.0 * UNREADABLE_RAW_PROFILE_LIMIT))
    parser.add_option('--test-scope-file', metavar='FILE',
                      help='JSON record of which tests the profiles came from, as '
                           'webkit-coverage writes it. A selective run\'s coverage is a lower '
                           'bound -- adding tests can only turn a line from uncovered to '
                           'covered -- so with a selective scope every total is written >=, the '
                           'output directory and trace get a -selective infix, and '
                           '--fail-under-lines fails because there is no exact number to gate '
                           'on. Without this the report says full-suite. See the note below')
    parser.add_option('-v', '--verbose', action='store_true', default=False, help='Verbose logging')

    options, remaining = parser.parse_args(args)
    if remaining:
        parser.error('Unexpected arguments: {}'.format(' '.join(remaining)))
    sources = [name for name, given in (('--coverage-dir', options.coverage_dir),
                                        ('--profdata', options.profdata),
                                        ('--suite', options.suite)) if given]
    if len(sources) != 1:
        parser.error('pass exactly one of --coverage-dir, --profdata or --suite (repeated), '
                     'not {}'.format(' and '.join(sources) if sources else 'none of them'))
    if not options.output_dir:
        parser.error('--output-dir is required')
    if options.coverage_dir and not os.path.isdir(options.coverage_dir):
        parser.error('--coverage-dir {} is not a directory'.format(options.coverage_dir))
    if options.profdata and not os.path.isfile(options.profdata):
        parser.error('--profdata {} does not exist'.format(options.profdata))
    # The port appends the configuration, so strip a trailing one rather than resolve to
    # .../Release/Release.
    options.build_directory_note = None
    if options.build_directory:
        build_root = normalize_build_root(options.build_directory, options.configuration)
        options.build_directory_note = build_root.note
        options.build_directory = build_root.root
    # Parse early: a bad scope file must fail, not silently downgrade to "full suite".
    options.scope = CoverageScope.full_suite()
    if options.test_scope_file:
        if not os.path.isfile(options.test_scope_file):
            parser.error('--test-scope-file {} does not exist'.format(options.test_scope_file))
        try:
            options.scope = CoverageScope.read(options.test_scope_file)
        except (ValueError, OSError) as error:
            parser.error('--test-scope-file {} could not be read: {}'.format(
                options.test_scope_file, error))
    # Fail on a typo before anything is read or written.
    try:
        parse_suite_specs(options.suite)
    except SuiteSpecError as error:
        parser.error(str(error))
    if options.products is not None:
        known = [product_name(entry) for entry in KNOWN_PRODUCTS]
        unknown = [name for name in options.products.split(',') if name and name not in known]
        if unknown:
            parser.error('--products names {}, which is not one of {}'.format(
                ', '.join(unknown), ', '.join(known)))
    for metric, threshold in thresholds_from_options(options).items():
        if not 0.0 <= threshold <= 100.0:
            parser.error('{} is a percentage, so it must be between 0 and 100'.format(
                option_name(metric)))
    options.export_formats = ()
    if options.export:
        try:
            options.export_formats = parse_formats(options.export)
        except ExportError as error:
            parser.error(str(error))
    return options


def exit_status(gate_status, export_failed):
    """The gate's own status wins. A failed export only turns success into 1."""
    return gate_status or (1 if export_failed else 0)


def write_exports(formats, lcov_path, output_directory, source_root, scope):
    """Write the --export formats beside the report. False, after saying why, on failure."""
    try:
        written = export_trace(lcov_path, os.path.join(output_directory, 'export'), formats,
                               source_root=source_root, scope=scope)
    except ExportError as error:
        _log.error('--export failed: %s', error)
        return False
    for path in written:
        _log.info('Wrote %s (%.1f MB)', path, os.path.getsize(path) / 1e6)
    return True


def summarize_absent_files(port, lcov_path, ignore_regexes, output_directory, sources=()):
    """Report the files the coverage data cannot describe. An AbsenceReport, or None when the build directory cannot answer."""
    canonicalizer = PathCanonicalizer(port.webkit_base())
    reported = parse_lcov_source_files(lcov_path, canonicalizer)
    absence = find_absent_files(port.webkit_base(), port._build_path(), reported, ignore_regexes)
    if not absence.compiled_file_count:
        _log.warning('Found no compiler dependency files or unified-source bundles under %s, '
                     'so the report cannot show which files this configuration never built. '
                     'Percentages below are over an unknown fraction of the tree.',
                     port._build_path())
        return None
    if sources:
        absence = restrict_absence_to_scope(absence, port.webkit_base(), sources)

    _log.info('%s', absence.denominator_sentence())
    for _, label, files, lines in absence.reasons():
        _log.info('    %6d files  %9d physical lines  %s', files, lines, label)

    listing = os.path.join(output_directory, 'not-built.tsv')
    with open(listing, 'w') as handle:
        handle.write('path\treason\tdetail\tphysical_lines\n')
        for absent in absence.files:
            handle.write('{}\t{}\t{}\t{}\n'.format(
                absent.path, absent.reason, absent.detail, absent.physical_lines))
    _log.info('Wrote %s', listing)
    return absence


def restrict_absence_to_scope(absence, checkout_root, sources):
    """An AbsenceReport over only the files under one of the --sources scopes.

    Files outside a scoped trace are absent by construction, so they must not count as never compiled.
    """
    from webkitpy.coverage_build_inventory import AbsenceReport, enumerate_source_files

    restricted = AbsenceReport()
    restricted.compiled_file_count = absence.compiled_file_count
    for absent in absence.files:
        if is_under_any(os.path.join(checkout_root, absent.path), sources):
            restricted.add(absent)
    in_scope = sum(1 for relative in enumerate_source_files(checkout_root)
                   if is_under_any(os.path.join(checkout_root, relative), sources))
    restricted.total_file_count = in_scope
    restricted.reported_file_count = max(0, in_scope - restricted.absent_file_count)
    return restricted


def warn_about_objects_with_no_profile_data(objects, raw_profiles):
    """Warn when a binary in the report cannot have contributed profile data: it would show as 0.00%, like untested code."""
    findings = objects_with_no_profile_data(objects, raw_profiles)
    if not findings:
        return
    _log.warning('%d of the %d binaries in this report can have contributed no profile data at '
                 'all, so every line they contain is about to be reported as untested:',
                 len(findings), len(objects))
    for path, reason in findings:
        _log.warning('    %s', path)
        _log.warning('        %s', reason)
    _log.warning('    Exclude them, or fix their configuration -- do not read their coverage.')


def report_instrumentation_survey(objects, build_directory):
    """Warn about binaries that are not instrumented or cannot be checked. False when none is instrumented."""
    survey = survey_instrumentation(objects)
    if survey.uninstrumented and len(survey.uninstrumented) == len(objects):
        _log.error('None of the %d binaries under %s is instrumented for coverage, so there is '
                   'nothing to report on:', len(objects), build_directory)
        for path, _ in survey.uninstrumented:
            _log.error('    %s', path)
        _log.error('Build with --coverage, or point --build-directory at the tree the tests ran '
                   'against.')
        return False
    if survey.uninstrumented:
        _log.warning('%d of the %d binaries in this report are not instrumented, so every file '
                     'only they contain is absent from the report rather than reported at 0%%:',
                     len(survey.uninstrumented), len(objects))
        for path, reason in survey.uninstrumented:
            _log.warning('    %s', path)
            _log.warning('        %s', reason)
        _log.warning('    Is %s the tree the tests ran against?', build_directory)
    for path, reason in survey.unverifiable:
        _log.info('Cannot check where %s writes its profile: %s', path, reason)
    return True


def left_out_binary_paths(port, objects):
    """The known products this build has and this report leaves out on purpose."""
    paths = (port._build_path(*relative.split('/')) for relative in KNOWN_PRODUCTS)
    return [path for path in paths if os.path.exists(path) and path not in objects]


def warn_about_collected_profiles_with_no_object(objects, raw_profiles, left_out=()):
    """Warn when collected profile data belongs to no binary in the report. The inverse of warn_about_objects_with_no_profile_data()."""
    orphans = collected_profiles_with_no_object(objects, raw_profiles)
    if not orphans:
        return
    unexplained, expected = partition_unclaimed_profiles(
        orphans, UNREPORTED_PROFILE_WRITERS, claimed_profile_name_prefixes(left_out))
    if expected:
        _log.info('%d of the %d raw profiles this run collected were written by binaries this '
                  'report does not describe, which is by design; their counters for code a '
                  'reported binary also contains still count: %s',
                  sum(len(paths) for _, paths in expected), len(raw_profiles),
                  ', '.join(group + '*' for group, _ in expected))
    if not unexplained:
        return
    total = sum(len(paths) for _, paths in unexplained)
    _log.warning('%d of the %d raw profiles this run collected were written by something no '
                 'binary in this report claims to be, so their coverage is in the indexed '
                 'profile and in none of the report:', total, len(raw_profiles))
    for group, paths in unexplained:
        megabytes = sum(os.path.getsize(path) for path in paths
                        if os.path.exists(path)) / 1e6
        _log.warning('    %s*: %d profiles, %.1f MB, for example %s', group, len(paths),
                     megabytes, os.path.basename(paths[0]))
    _log.warning('    Add the binary that writes each of those to --products/INSTRUMENTED_PRODUCTS '
                 'or pass it with --object, or the code in it is reported as not existing. If it is '
                 'a driver, service or test binary no report should describe, add its name to '
                 'UNREPORTED_PROFILE_WRITERS instead.')


def summarize_suites(source_root, suite_lcov_paths, combined_by_path):
    """[(suite name, {path: (lines, covered)})], after checking the combined column is their union.

    Checked every run: llvm-cov output is profile-dependent. The per-line maps are dropped afterwards.
    """
    suites_by_path = {}
    for name, path in suite_lcov_paths:
        # No build directory: the residue is the same for every suite and is reported once, from the combined trace.
        parsed = parse_lcov(path, PathCanonicalizer(source_root), lines_only=True)
        _log.info('Suite %s: %d files, %.1f MB of trace', name, len(parsed),
                  os.path.getsize(path) / 1e6)
        suites_by_path[name] = parsed

    log_union_check(check_union_equals_combined(combined_by_path, suites_by_path),
                    [name for name, _ in suite_lcov_paths])
    return [(name, line_totals(suites_by_path[name])) for name, _ in suite_lcov_paths]


def summary_banner_lines(scope, summary_text):
    """The block above llvm-cov's table in summary.txt, restating TOTAL as lower bounds. Empty for a full-suite run."""
    if not scope.is_selective:
        return []
    lines = ['# ' + line for line in scope.banner_lines()]
    total = next((line for line in reversed(summary_text.splitlines())
                  if line.startswith('TOTAL')), None)
    if total:
        lines.append('# The TOTAL line below, restated as the lower bounds it is:')
        lines.append('#   ' + scope.qualify_percentages(total).strip())
    lines.append('#')
    return lines


def summary_total_lines(summary_text):
    """llvm-cov's TOTAL line, with the rule above it, for echoing to the terminal. Searched for, not sliced off the end."""
    lines = summary_text.splitlines()
    for index in range(len(lines) - 1, -1, -1):
        if not lines[index].startswith('TOTAL'):
            continue
        rule = lines[index - 1].strip() if index else ''
        return lines[index - 1:index + 1] if rule and set(rule) == {'-'} else [lines[index]]
    # No TOTAL line: show the tail so the output is at least visible.
    return lines[-3:]


def main(args):
    options = parse_args(args)
    logging.basicConfig(level=logging.DEBUG if options.verbose else logging.INFO,
                        format='%(levelname)s: %(message)s')

    host = Host()
    port = host.port_factory.get(options.platform, options)

    if options.build_directory_note:
        _log.info('%s', options.build_directory_note)

    # The -selective infix goes on before anything is written: a directory called `report` holding
    # lower bounds must not look like one holding exact numbers.
    if options.scope.is_selective:
        renamed = options.scope.directory(options.output_dir)
        if renamed != options.output_dir:
            _log.info('Selective run, so writing to %s rather than %s: a report of lower bounds '
                      'must not be mistakable for a full-suite one after it has been moved.',
                      renamed, options.output_dir)
            options.output_dir = renamed

    # Resolve first: when --sources matches nothing, llvm-cov reports the whole tree and does not complain.
    sources, missing_sources = resolve_source_scopes(options.sources, port.webkit_base())
    if missing_sources:
        for path in missing_sources:
            _log.error('--sources %s does not exist', path)
        _log.error('llvm-cov matches --sources against paths recorded in the coverage mapping, '
                   'and reports the whole tree rather than failing when none of them match.')
        return 1
    if sources:
        _log.info('Reporting only on %s, so every total below is that scope and not the project.',
                  ', '.join(sources))

    # The coverage mapping records staged-header paths, which PathCanonicalizer maps back only after
    # llvm-cov has applied --sources. Pass both spellings or the filter matches nothing.
    llvm_cov_sources = list(sources)
    for scope in sources:
        for staged in staged_equivalents_for_scope(scope, port.webkit_base(),
                                                   port._build_path()):
            if staged not in llvm_cov_sources:
                llvm_cov_sources.append(staged)
                _log.info('Also passing %s to llvm-cov: it is where the build stages the '
                          'headers of %s, and that is the path the coverage mapping records.',
                          staged, scope)

    try:
        objects = instrumented_binary_paths(port, options.extra_objects,
                                            options.include_test_support, options.products)
    except RuntimeError as error:
        _log.error('%s', error)
        return 1
    if not objects:
        _log.error('Found no instrumented frameworks under %s.', port._build_path())
        _log.error('Build with --coverage first, or pass --build-directory.')
        return 1
    for path in objects:
        _log.info('Including %s', path)

    os.makedirs(options.output_dir, exist_ok=True)

    suites = []
    unreadable_profiles = []
    if options.suite:
        try:
            suites = resolve_suites(options.suite, options.output_dir)
        except (SuiteSpecError, RuntimeError) as error:
            _log.error('%s', error)
            return 1
        profile_path = merge_suite_profiles(
            suites, os.path.join(options.output_dir, 'coverage.profdata'))
        raw_profiles = [path for suite in suites for path in suite.raw_profiles]
    elif options.profdata:
        profile_path = options.profdata
        raw_profiles = []
        _log.info('Reporting from the already-indexed profile %s', profile_path)
    else:
        profile_path = os.path.join(options.output_dir, 'coverage.profdata')
        try:
            merge = merge_coverage_profiles(
                options.coverage_dir, profile_path,
                unreadable_limit=1.0 if options.allow_unreadable_profiles else
                UNREADABLE_RAW_PROFILE_LIMIT)
        except RuntimeError as error:
            _log.error('%s', error)
            _log.error('Pass --allow-unreadable-profiles to report from the readable remainder '
                       'anyway.')
            return 1
        raw_profiles, unreadable_profiles = merge.merged, merge.unreadable
        _log.info('Indexed %d raw profiles into %s', len(raw_profiles), profile_path)

    if not report_instrumentation_survey(objects, port._build_path()):
        return 1
    warn_about_objects_with_no_profile_data(objects, raw_profiles)
    warn_about_collected_profiles_with_no_object(objects, raw_profiles,
                                                 left_out_binary_paths(port, objects))

    ignore_regexes = list(DEFAULT_IGNORE_REGEXES) + list(options.ignore_regexes)
    if not options.include_third_party:
        ignore_regexes += list(THIRD_PARTY_IGNORE_REGEXES)
        copied = third_party_copied_header_ignore_regexes(port._build_path())
        if copied:
            # Log the regexes, not names derived from them: the two build systems use different shapes.
            _log.info('Excluding %d third-party copied-header directories the build installed: '
                      '%s', len(copied), ', '.join(copied))
            ignore_regexes += copied

    summary_path = os.path.join(options.output_dir, 'summary.txt')
    # Same infix as the directory: the trace outlives the report, so its name must say whether
    # its numbers are exact.
    lcov_path = os.path.join(options.output_dir, options.scope.filename(
        'coverage.lcov.gz' if options.compress_lcov else 'coverage.lcov'))
    html_dir = os.path.join(options.output_dir, 'html')
    suite_lcov_paths = [
        (suite.name, os.path.join(options.output_dir, options.scope.filename(
            'coverage-{}.lcov.gz'.format(suite.name) if options.compress_lcov else
            'coverage-{}.lcov'.format(suite.name))))
        for suite in suites] if len(suites) > 1 else []

    # Built before the trace so the trace can carry a header comment; its own measurements are added later.
    provenance = provenance_record(
        port.webkit_base(), port._build_path(), port.name(), port.get_option('configuration'),
        objects, profile_path, command_line=args, products=options.products,
        suites=[(suite.name, suite.source) for suite in suites],
        raw_profile_count=len(raw_profiles),
        unreadable_raw_profile_count=len(unreadable_profiles),
        ignore_filename_regexes=ignore_regexes,
        sources_scope=sources,
        include_third_party=options.include_third_party,
        include_test_support=options.include_test_support,
        scope=options.scope,
        generator=os.path.basename(__file__))
    for line in summary_lines(provenance):
        _log.info('%s', line)

    # Independent and slow, so run them concurrently. The threads only wait on separate processes.
    def make_summary():
        return LLVMCov.report(objects, profile_path, ignore_regexes, options.path_equivalence,
                              check_binary_ids=True, sources=llvm_cov_sources)

    def make_lcov():
        return LLVMCov.export_lcov(objects, profile_path, lcov_path, ignore_regexes,
                                   options.path_equivalence, compress=options.compress_lcov,
                                   header_line=trace_comment(provenance),
                                   sources=llvm_cov_sources)

    def make_html():
        return LLVMCov.show_html(objects, profile_path, html_dir, ignore_regexes,
                                 options.path_equivalence,
                                 show_instantiations=options.show_instantiations,
                                 sources=llvm_cov_sources)

    def make_suite_lcov(suite_profile, output_path):
        return lambda: LLVMCov.export_lcov(objects, suite_profile, output_path, ignore_regexes,
                                           options.path_equivalence,
                                           compress=options.compress_lcov,
                                           header_line=trace_comment(provenance),
                                           sources=llvm_cov_sources)

    regions_path = os.path.join(options.output_dir, '.coverage-regions.json')

    def make_regions():
        return LLVMCov.export_regions_json(objects, profile_path, regions_path, ignore_regexes,
                                           options.path_equivalence, sources=llvm_cov_sources)

    work = {'summary': make_summary}
    # The index and line views are built from the lcov trace, so it is needed even with --no-lcov.
    work['lcov'] = make_lcov
    if options.llvm_cov_html:
        work['html'] = make_html
    if options.html and options.source_views and options.regions:
        work['regions'] = make_regions
    for suite, (_, suite_lcov_path) in zip(suites, suite_lcov_paths):
        work['lcov ' + suite.name] = make_suite_lcov(suite.profdata, suite_lcov_path)
    if len(suites) == 1:
        _log.info('One suite, so it needs no column of its own: the combined column is it.')

    _log.info('Running %d llvm-cov invocations concurrently: %s',
              len(work), ', '.join(sorted(work)))
    with ThreadPoolExecutor(max_workers=len(work)) as pool:
        futures = {name: pool.submit(function) for name, function in work.items()}
        results = {name: future.result() for name, future in futures.items()}

    for name, result in results.items():
        if result.returncode and name == 'regions':
            # Only the in-line highlighting depends on it, so the report goes ahead without.
            _log.warning('llvm-cov %s failed, so the line views mark whole lines only: %s',
                         name, result.stderr)
        elif result.returncode:
            _log.error('llvm-cov %s failed: %s', name, result.stderr)
            return 1

    # llvm-cov silently reports the whole tree when --sources matches no recorded path, which
    # contradicts the scope banner. Fatal, because every consumer of the trace believes the banner.
    if sources:
        canonicalizer = PathCanonicalizer(port.webkit_base(), build_directory=port._build_path())
        reported = parse_lcov_source_files(lcov_path, canonicalizer)
        outside = sorted(path for path in reported if not is_under_any(path, sources))
        if outside:
            _log.error('llvm-cov ignored --sources: %d of the %d files in the trace are outside '
                       'the requested scope.', len(outside), len(reported))
            for path in outside[:5]:
                _log.error('    %s', path)
            if len(outside) > 5:
                _log.error('    ... and %d more', len(outside) - 5)
            _log.error('llvm-cov reports everything, silently, when a --sources filter matches '
                       'no path in the coverage mapping. Check that %s is a path the mapping '
                       'records for these objects; a framework compiled against staged headers '
                       'records the build directory path instead.', ', '.join(sources))
            return 1

    # Rebuilding between the tests and the report gives a complete-looking, wrong report that llvm-cov
    # flags only on stderr. Use its "profile data may be out of date" warning, not the "mismatched data"
    # count: WTF and bmalloc are linked into several frameworks, so a correct report has many of those.
    stale_objects = set()
    mismatched = 0
    for result in results.values():
        for line in (result.stderr or '').splitlines():
            match = re.search(r'warning: (.*): profile data may be out of date', line)
            if match:
                stale_objects.add(match.group(1))
            count = re.search(r'(\d+) functions have mismatched data', line)
            if count:
                mismatched = max(mismatched, int(count.group(1)))

    if mismatched:
        _log.info('%d functions have mismatched data. Some of that is expected: WTF and bmalloc '
                  'are linked into several frameworks, so the same function has a different hash '
                  'in each.', mismatched)

    if stale_objects:
        _log.error('These binaries are newer than the profile, so the report would be wrong:')
        for path in sorted(stale_objects):
            _log.error('    %s', path)
        _log.error('Re-run the tests against the current build, or pass --allow-profile-mismatch.')
        if not options.allow_profile_mismatch:
            return 1

    with open(summary_path, 'w') as summary_file:
        # Prepended, so llvm-cov's own table stays exactly as produced.
        for line in summary_banner_lines(options.scope, results['summary'].stdout):
            summary_file.write(line + '\n')
        summary_file.write(results['summary'].stdout)
    for line in options.scope.banner_lines():
        print(line)
    for line in summary_total_lines(results['summary'].stdout):
        print(options.scope.qualify_percentages(line))
    _log.info('Wrote %s', summary_path)

    # Rewrite the trace to the paths the report shows, before its size is logged and its measurements
    # recorded. summary.txt stays as llvm-cov wrote it; the trace is this tool's artifact and must
    # agree with the report.
    trace_canonicalizer = PathCanonicalizer(port.webkit_base(),
                                            build_directory=port._build_path())
    for path in [lcov_path] + [path for _, path in suite_lcov_paths]:
        rewrite = canonicalize_lcov(path, trace_canonicalizer)
        if rewrite.rewritten or rewrite.merged:
            _log.info('%s: rewrote %d staged path(s) and unioned %d file(s) that llvm-cov '
                      'reported under two paths, %d records to %d', os.path.basename(path),
                      rewrite.rewritten, rewrite.merged, rewrite.records_in, rewrite.records_out)

    _log.info('Wrote %s (%.1f MB)', lcov_path, os.path.getsize(lcov_path) / 1e6)
    for name, path in suite_lcov_paths:
        _log.info('Wrote %s (%.1f MB), suite %s', path, os.path.getsize(path) / 1e6, name)

    # Written even with --no-lcov, and before anything below that can fail.
    _log.info('Wrote %s', write_provenance(
        add_trace_measurements(provenance, lcov_path), options.output_dir))

    # A file this configuration never compiled has no coverage mapping, so it is absent from the trace
    # rather than present at 0%. The same in every suite, so reported once. No synthetic 0% rows: a
    # compiled file with nothing to count would invent a denominator.
    absence = None
    if options.build_inventory:
        absence = summarize_absent_files(port, lcov_path, ignore_regexes, options.output_dir,
                                         sources=sources)

    thresholds = thresholds_from_options(options)
    totals = None
    combined_by_path = None
    if options.html or thresholds or suite_lcov_paths:
        # One parse of the combined trace, shared by the per-suite check, the gate and the HTML.
        canonicalizer = PathCanonicalizer(port.webkit_base(),
                                          build_directory=port._build_path())
        combined_by_path = parse_lcov(lcov_path, canonicalizer, keep_function_names=False)
        if not combined_by_path:
            _log.error('%s contained no coverage records.', lcov_path)
            return 1
        canonicalizer.log_summary()
        totals = project_totals(combined_by_path)

    suite_line_totals = []
    if suite_lcov_paths:
        suite_line_totals = summarize_suites(port.webkit_base(), suite_lcov_paths,
                                             combined_by_path)

    regions = None
    if combined_by_path and 'regions' in results and not results['regions'].returncode:
        regions = uncovered_regions(
            regions_path, PathCanonicalizer(port.webkit_base(), build_directory=port._build_path()),
            covered_lines={path: coverage.lines for path, coverage in combined_by_path.items()})
    if os.path.exists(regions_path):
        os.unlink(regions_path)

    if options.html and options.source_views:
        report = write_report(lcov_path, options.output_dir, source_root=port.webkit_base(),
                              absence=absence, build_directory=port._build_path(),
                              index_link='html/index.html' if options.llvm_cov_html else None,
                              coverage_by_path=combined_by_path,
                              suite_line_totals=suite_line_totals, scope=options.scope,
                              regions=regions, thresholds=thresholds)
        _log.info('Wrote %d directory pages and %d line views (%.1f MB); start at %s',
                  report.directory_pages, report.source_pages, report.source_bytes / 1e6,
                  os.path.join(options.output_dir, 'index.html'))
        if options.llvm_cov_html:
            _log.info('Wrote %s', os.path.join(html_dir, 'index.html'))
    elif options.html:
        # Every file is listed without a link because no line views exist; the tooltip is the one used
        # for unreadable source.
        pages = write_directory_index(
            lcov_path, options.output_dir, source_root=port.webkit_base(), absence=absence,
            build_directory=port._build_path(), coverage_by_path=combined_by_path,
            unlinkable=set(combined_by_path), suite_line_totals=suite_line_totals,
            index_link='html/index.html' if options.llvm_cov_html else None,
            scope=options.scope, thresholds=thresholds)
        _log.info('Wrote %d directory pages and no line views (--no-source-views); start at %s',
                  pages, os.path.join(options.output_dir, 'index.html'))

    # After the report and the provenance, so a failed export costs neither; it still fails the run.
    export_failed = bool(options.export_formats) and not write_exports(
        options.export_formats, lcov_path, options.output_dir, port.webkit_base(), options.scope)

    if not options.lcov:
        os.unlink(lcov_path)
        for _, path in suite_lcov_paths:
            os.unlink(path)

    if not options.keep_raw_profiles:
        for path in raw_profiles:
            os.unlink(path)
        _log.info('Deleted %d raw profiles', len(raw_profiles))
        if unreadable_profiles:
            # Kept: they are the only evidence of what went wrong.
            _log.info('Kept %d unreadable raw profiles', len(unreadable_profiles))

    # Last: a failed gate must leave the report behind.
    gate_status = check_absolute_thresholds(thresholds, totals, scope=options.scope) if thresholds else 0
    if export_failed:
        _log.error('--export failed. The report itself was written.')
    return exit_status(gate_status, export_failed)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
