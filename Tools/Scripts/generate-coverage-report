"""Turn LLVM raw profiles from an instrumented test run into a coverage report.

Build with coverage instrumentation, run the tests, then generate the report:

    Tools/Scripts/build-webkit --xcode --release --coverage --lto-mode=none
    Tools/Scripts/run-api-tests --release --coverage --coverage-dir=/tmp/cov WTF
    Tools/Scripts/run-webkit-tests --release --coverage --coverage-dir=/tmp/cov fast/forms
    Tools/Scripts/generate-coverage-report --release --coverage-dir=/tmp/cov --output-dir=/tmp/covreport

Give each run its own --coverage-dir instead, and each suite gets a column of its own:

    Tools/Scripts/run-api-tests --release --coverage --coverage-dir=/tmp/cov-api WTF
    Tools/Scripts/run-webkit-tests --release --coverage --coverage-dir=/tmp/cov-layout fast/forms
    Tools/Scripts/generate-coverage-report --release --output-dir=/tmp/covreport \\
        --suite=api:/tmp/cov-api --suite=layout:/tmp/cov-layout
"""

import logging
import optparse
import os
import re
import sys

from concurrent.futures import ThreadPoolExecutor

from webkitpy.common.host import Host
from webkitpy.coverage_build_inventory import find_absent_files
from webkitpy.coverage_directory_index import write_report
from webkitpy.coverage_lcov import (
    PathCanonicalizer, parse_lcov, parse_lcov_source_files, project_totals,
    third_party_copied_header_ignore_regexes)
from webkitpy.coverage_suites import (
    SuiteSpecError, check_union_equals_combined, line_totals, log_union_check,
    merge_suite_profiles, parse_suite_specs, resolve_suites)
from webkitpy.coverage_thresholds import (
    COVERAGE_GATE_EXIT_CODE, GATED_METRICS, check_absolute_thresholds, destination_name,
    option_name, thresholds_from_options)
from webkitpy.llvm_profile_utils import (
    LLVMCov, merge_all_raw_profiles_in_directory, objects_with_no_profile_data)
from webkitpy.port import configuration_options, platform_options

_log = logging.getLogger('generate-coverage-report')

# Every instrumented binary that llvm-cov must be given. Omitting one does not fail or warn:
# llvm-cov simply reports nothing for the files only that binary contains, so the code looks
# absent rather than uncovered. WebKitLegacy was missing here, which silently discarded all
# 302 of its files -- 41MB of instrumented product code with eight __llvm_prf sections.
#
# WTF and bmalloc need no entry: they are static libraries, so their coverage mapping lives
# inside the binaries that link them.
INSTRUMENTED_PRODUCTS = (
    'JavaScriptCore.framework/Versions/A/JavaScriptCore',
    'WebCore.framework/Versions/A/WebCore',
    'WebKit.framework/Versions/A/WebKit',
    'WebKitLegacy.framework/Versions/A/WebKitLegacy',
    'WebGPU.framework/Versions/A/WebGPU',
)

# Instrumented too, and loaded during a test run, but they are test scaffolding or tools
# rather than shipping code, so including them would put their line counts in the product
# denominator. Skipped by default -- but reported as skipped, because silently dropping
# instrumented data is exactly the bug above.
TEST_SUPPORT_PRODUCTS = (
    'libWebCoreTestSupport.dylib',
    'jsc',
    'webpushd',
    'adattributiond',
)

# Everything --products may name. Both lists, because --products restricts both.
KNOWN_PRODUCTS = INSTRUMENTED_PRODUCTS + TEST_SUPPORT_PRODUCTS

# Report-time exclusions. On the Xcode build CLANG_COVERAGE_MAPPING is a command-line
# override applied to every target in the scheme, so this is the only place third-party code
# can be excluded.
#
# Matching only 'Source/ThirdParty/' is not enough. Headers that get copied into the build
# directory are attributed to the copy, so libwebrtc's headers arrive as
# .../usr/local/include/webrtc/... and slip past a Source/ThirdParty/ pattern entirely --
# that was 12,900 lines of 5%-covered code silently dragging the totals down.
#
# Nor is naming the copy locations that have been seen enough, which is why
# coverage_lcov.third_party_copied_header_ignore_regexes() adds the rest from the build
# directory's own layout: libwebrtc also installs headers under api/, rtc_base/, p2p/,
# logging/ and video/, and 26 of those were still in a full-suite report.
THIRD_PARTY_IGNORE_REGEXES = (
    'Source/ThirdParty/',
    '/usr/local/include/webrtc/',
    '/usr/local/include/libwebrtc/',
    '/ThirdParty/',
)

DEFAULT_IGNORE_REGEXES = (
    '/DerivedSources/',
    '/Applications/Xcode.app/',
    r'\.sdk/',
    '/usr/include/',
)

# The absolute-coverage gate, whose exit code and metric list live in coverage_thresholds so
# that this tool and compare-coverage-reports fail a build the same way. Per-suite attribution
# lives in coverage_suites; the note below is the short version of that module's docstring.
_EPILOG = """
--suite=NAME:PATH gives one test suite a line-coverage column of its own, so that a gap can be
attributed to the suite that should have closed it. Give each harness run its own
--coverage-dir and then name them:

  Tools/Scripts/run-webkit-tests --release --coverage --coverage-dir=/tmp/cov-layout
  Tools/Scripts/run-api-tests    --release --coverage --coverage-dir=/tmp/cov-api
  Tools/Scripts/generate-coverage-report --release --output-dir=/tmp/report \\
      --suite=layout:/tmp/cov-layout --suite=api:/tmp/cov-api

Separating the runs has to be asked for when they run: collected profiles are named after the
framework that wrote them and not after the run, so two runs that shared one --coverage-dir
cannot be told apart afterwards. This warns when it is given a directory that holds more than
one run's profiles, because the alternative is a silently mislabelled column.

The combined column is reported from the merge of the suites' profiles, so it is the union of
the lines they executed and not the sum -- a line two suites reach counts once -- and it is by
construction what a single merged profile produces. Every run checks that against the union of
the per-suite traces and says so.

--fail-under-lines, --fail-under-functions and --fail-under-branches gate on absolute
coverage. A report that is written but below the threshold exits {gate} rather than 1, so that
a bot can tell "coverage is too low" from "the tooling broke", and the report is written
either way, because the report is how somebody works out why the gate fired.

They are checked against the totals this report displays, which are NOT the TOTAL line in
summary.txt: llvm-cov counts a copied header once per framework that includes it, which on a
full-suite run is 2,098,175 lines against the report's 1,889,061, and 72.09% function coverage
against 55.05%, because llvm-cov counts each template instantiation as a function while lcov's
records are keyed by mangled name.

There is deliberately no --fail-under-regions: regions exist only in summary.txt, on that
other denominator, and lcov carries no region records to compute a comparable number from.
There is deliberately no bare --fail-under either. The four metrics span 15 percentage points
on a full-suite run -- 72.09% of functions, 67.41% of lines, 57.60% of regions, 52.80% of
branches -- so one flag meaning whichever of them the tool happened to pick would gate the
wrong thing without saying so.
""".format(gate=COVERAGE_GATE_EXIT_CODE)


class _PreformattedEpilog(optparse.IndentedHelpFormatter):
    """optparse rewraps the epilog into one blob, and the paragraph breaks carry meaning."""

    def format_epilog(self, epilog):
        return epilog or ''


def product_name(relative):
    """The name --products matches on: JavaScriptCore, WebCore, jsc, ...

    The basename, which is the framework's binary for a framework and the tool itself for a
    tool, so one spelling covers both kinds of entry.
    """
    return os.path.basename(relative)


def selected_products(products, available):
    """The entries of available that products names, or all of them when products is None.

    An empty --products selects nothing, which together with --object is how a tool that
    already knows its own product's path asks for exactly that one and nothing else. Names
    are validated in parse_args, against every known product rather than against one list:
    --products=JavaScriptCore has to be a legal restriction of the test-support list too, and
    select none of it.
    """
    if products is None:
        return list(available)
    wanted = [name for name in products.split(',') if name]
    return [entry for entry in available if product_name(entry) in wanted]


def instrumented_binary_paths(port, extra_objects, include_test_support, products=None):
    """Locate every instrumented Mach-O to pass to llvm-cov.

    All of them must go into a single llvm-cov invocation. Omitting one silently
    under-reports the files only it contains, and reporting per-binary and stitching the
    results afterwards double-counts the header-inline functions that llvm-profdata has
    already merged by function name.
    """
    objects = []
    missing = []
    for relative in selected_products(products, INSTRUMENTED_PRODUCTS):
        path = port._build_path(*relative.split('/'))
        if os.path.exists(path):
            objects.append(path)
        else:
            missing.append(relative)
    if missing:
        # Loud, not debug: a product that exists but was not found here is indistinguishable
        # in the report from a product with no coverage at all.
        _log.warning('Not found in the build directory, so absent from the report: %s',
                     ', '.join(missing))

    skipped = []
    for relative in selected_products(products, TEST_SUPPORT_PRODUCTS):
        path = port._build_path(*relative.split('/'))
        if not os.path.exists(path):
            continue
        if include_test_support:
            objects.append(path)
        else:
            skipped.append(relative)
    if skipped:
        _log.info('Skipping test-support and tool binaries (pass --include-test-support to '
                  'include them): %s', ', '.join(skipped))

    for path in extra_objects:
        if not os.path.exists(path):
            raise RuntimeError('--object {} does not exist'.format(path))
        objects.append(path)

    return objects


def parse_args(args):
    parser = optparse.OptionParser(usage='%prog [options] --coverage-dir=DIR --output-dir=DIR',
                                   epilog=_EPILOG, formatter=_PreformattedEpilog())
    parser.add_options(platform_options())
    parser.add_options(configuration_options())
    parser.add_option('--coverage-dir', help='Directory holding the .profraw files from an instrumented test run')
    parser.add_option('--profdata', help='Report from an already-indexed profile instead of raw profiles. Use this '
                                         'when a run was sharded and the shards were merged incrementally, which is '
                                         'how a full-suite run avoids accumulating hundreds of GB of raw profiles')
    parser.add_option('--output-dir', help='Directory to write the report into')
    parser.add_option('--suite', action='append', default=[], metavar='NAME:PATH',
                      help='Report one test suite as a column of its own, from its own '
                           'profiles. PATH is a --coverage-dir from that suite\'s run, or an '
                           'already-indexed .profdata. Repeatable, and the combined column is '
                           'the union of all of them. See the note below')
    parser.add_option('--build-directory', help='Path to the build directory, if not the default')
    parser.add_option('--object', action='append', dest='extra_objects', default=[],
                      help='Additional instrumented binary to include (repeatable)')
    parser.add_option('--products', metavar='LIST',
                      help='Comma-separated list of the instrumented products to report on, out '
                           'of {}. Defaults to all of them. An empty list selects none, which '
                           'together with --object is how a tool that already knows its own '
                           "product's path asks for that one and nothing else".format(
                               ', '.join(product_name(entry) for entry in INSTRUMENTED_PRODUCTS)))
    parser.add_option('--path-equivalence', action='append', default=[], metavar='FROM,TO',
                      help='Passed through to llvm-cov, for reporting on a different machine than the '
                           'one that built. Note this only affects where llvm-cov looks for source text; '
                           'it does not rewrite the paths shown in the report (repeatable)')
    parser.add_option('--ignore-filename-regex', action='append', dest='ignore_regexes', default=[],
                      help='Additional exclusion regex, on top of the defaults (repeatable)')
    parser.add_option('--include-test-support', action='store_true', default=False,
                      help='Also report on instrumented test-support and tool binaries '
                           '(libWebCoreTestSupport, jsc, webpushd, adattributiond). Off by default '
                           'so their line counts stay out of the product denominator')
    parser.add_option('--include-third-party', action='store_true', default=False,
                      help='Report on Source/ThirdParty too. The code is already instrumented -- '
                           'libwebrtc and libANGLE both carry __llvm_prf sections and are linked into '
                           'WebCore -- so this only stops filtering it out, at the cost of a much '
                           'larger report')
    parser.add_option('--no-html', action='store_false', dest='html', default=True,
                      help='Skip the HTML report: the directory index and the per-file line views')
    parser.add_option('--llvm-cov-html', action='store_true', default=False,
                      help="Also produce llvm-cov's own per-file HTML pages, in html/. They are "
                           'off by default because they are 909 MB of the 1.7 GB a full-suite '
                           'report used to be, against 288 MB for the line views this generates '
                           "from the trace. What they add is sub-line detail lcov cannot express: "
                           'on a full-suite run, 23,081 covered lines contain a region that never '
                           'executed. Reach for this when tracking down one of those')
    parser.add_option('--show-instantiations', action='store_true', default=False,
                      help='Include per-template-instantiation sub-views in the llvm-cov HTML '
                           'pages, so this only does anything together with --llvm-cov-html. They '
                           'are omitted by default because they are expensive on template-heavy '
                           'code (395 MB versus 300 MB of HTML for JavaScriptCore alone) and do '
                           'not affect aggregate per-file line coverage')
    parser.add_option('--no-lcov', action='store_false', dest='lcov', default=True,
                      help='Skip the lcov export')
    parser.add_option('--no-compress-lcov', action='store_false', dest='compress_lcov', default=True,
                      help='Write coverage.lcov instead of coverage.lcov.gz. The trace is gzipped '
                           'by default because it is 94%% mangled function names and so compresses '
                           '13.8x -- 751 MB to 54 MB on a full-suite run -- and because piping '
                           'llvm-cov into the compressor keeps the uncompressed trace off disk '
                           'entirely. Everything that reads a trace sniffs for gzip, so an '
                           'uncompressed one is only needed by other tools')
    parser.add_option('--no-build-inventory', action='store_false', dest='build_inventory',
                      default=True,
                      help='Do not work out which files this configuration never compiled. '
                           'That third state is what stops 23%% of the tree being invisible '
                           'rather than visibly untested, so this is only for a build '
                           'directory whose intermediates have been pruned')
    parser.add_option('--keep-raw-profiles', action='store_true', default=False,
                      help='Keep the .profraw files. They are deleted once indexed by default: the raw '
                           'format has no compatibility guarantees, so it should not be archived')
    for metric in GATED_METRICS:
        parser.add_option(option_name(metric), type='float', metavar='PERCENT',
                          dest=destination_name(metric),
                          help='Exit {} if {} coverage is below PERCENT. See the note below'.format(
                              COVERAGE_GATE_EXIT_CODE, metric))
    parser.add_option('--allow-profile-mismatch', action='store_true', default=False,
                      help='Report anyway when the profile does not match the binaries. The default '
                           'is to refuse, because the resulting numbers look plausible but are wrong')
    parser.add_option('-v', '--verbose', action='store_true', default=False, help='Verbose logging')

    options, remaining = parser.parse_args(args)
    if remaining:
        parser.error('Unexpected arguments: {}'.format(' '.join(remaining)))
    sources = [name for name, given in (('--coverage-dir', options.coverage_dir),
                                        ('--profdata', options.profdata),
                                        ('--suite', options.suite)) if given]
    if len(sources) != 1:
        parser.error('pass exactly one of --coverage-dir, --profdata or --suite (repeated), '
                     'not {}'.format(' and '.join(sources) if sources else 'none of them'))
    if not options.output_dir:
        parser.error('--output-dir is required')
    if options.coverage_dir and not os.path.isdir(options.coverage_dir):
        parser.error('--coverage-dir {} is not a directory'.format(options.coverage_dir))
    if options.profdata and not os.path.isfile(options.profdata):
        parser.error('--profdata {} does not exist'.format(options.profdata))
    # Checked here rather than where the profiles are indexed, so that a typo fails before
    # anything has been read or written.
    try:
        parse_suite_specs(options.suite)
    except SuiteSpecError as error:
        parser.error(str(error))
    if options.products is not None:
        known = [product_name(entry) for entry in KNOWN_PRODUCTS]
        unknown = [name for name in options.products.split(',') if name and name not in known]
        if unknown:
            parser.error('--products names {}, which is not one of {}'.format(
                ', '.join(unknown), ', '.join(known)))
    for metric, threshold in thresholds_from_options(options).items():
        if not 0.0 <= threshold <= 100.0:
            parser.error('{} is a percentage, so it must be between 0 and 100'.format(
                option_name(metric)))
    return options


def summarize_absent_files(port, lcov_path, ignore_regexes, output_directory):
    """Work out and report the files the coverage data cannot describe at all.

    Returns an AbsenceReport, or None if the build directory does not carry enough of a
    record to answer the question -- in which case say so rather than implying the tree is
    fully covered by what the report does show.
    """
    canonicalizer = PathCanonicalizer(port.webkit_base())
    reported = parse_lcov_source_files(lcov_path, canonicalizer)
    absence = find_absent_files(port.webkit_base(), port._build_path(), reported, ignore_regexes)
    if not absence.compiled_file_count:
        _log.warning('Found no compiler dependency files or unified-source bundles under %s, '
                     'so the report cannot show which files this configuration never built. '
                     'Percentages below are over an unknown fraction of the tree.',
                     port._build_path())
        return None

    _log.info('%s', absence.denominator_sentence())
    for _, label, files, lines in absence.reasons():
        _log.info('    %6d files  %9d physical lines  %s', files, lines, label)

    listing = os.path.join(output_directory, 'not-built.tsv')
    with open(listing, 'w') as handle:
        handle.write('path\treason\tdetail\tphysical_lines\n')
        for absent in absence.files:
            handle.write('{}\t{}\t{}\t{}\n'.format(
                absent.path, absent.reason, absent.detail, absent.physical_lines))
    _log.info('Wrote %s', listing)
    return absence


def warn_about_objects_with_no_profile_data(objects, raw_profiles):
    """Say so when a binary in the report cannot have contributed anything to the profile.

    This has to be said out loud, because the report cannot say it. An instrumented binary that
    writes no profile is reported at 0.00%, which is indistinguishable from code that is tested
    by nothing -- and 0.00% over tens of thousands of lines reads as a test gap, so it is acted
    on as one. WebGPU.framework spent a full run reported at 0.00% across 45,005 lines and
    WebKitLegacy.framework at 0.13% across 39,327, and in both cases the answer was that
    neither project defined ENABLE_LLVM_COVERAGE, so neither had a profile path baked in.
    84,332 lines of instrumented code, described as untested, with nothing said about it.
    """
    findings = objects_with_no_profile_data(objects, raw_profiles)
    if not findings:
        return
    _log.warning('%d of the %d binaries in this report can have contributed no profile data at '
                 'all, so every line they contain is about to be reported as untested:',
                 len(findings), len(objects))
    for path, reason in findings:
        _log.warning('    %s', path)
        _log.warning('        %s', reason)
    _log.warning('    Exclude them, or fix their configuration -- do not read their coverage.')


def summarize_suites(source_root, suite_lcov_paths, combined_by_path):
    """[(suite name, {path: (lines, covered)})], after checking the combined column is their union.

    The combined column comes from a merged profile and each suite column from one profile, so
    the report is asserting that those two things agree. Two real jsc runs over the same
    binaries say they do -- 57,797 lines covered by one, 60,614 by the other, 66,408 by the
    merge, and 0 disagreements over all 767,366 instrumented lines -- but llvm-cov's output is
    profile-dependent in at least one respect, so this checks it every time rather than
    trusting that measurement.

    The per-line maps are dropped as soon as the check is done: they are 1.9 million entries
    per suite on a full-suite run, and the columns only need two numbers per file.
    """
    suites_by_path = {}
    for name, path in suite_lcov_paths:
        # A canonicalizer per suite, with no build directory: the residue is the same set of
        # paths for every suite, and reporting it once, from the combined trace, is enough.
        parsed = parse_lcov(path, PathCanonicalizer(source_root), lines_only=True)
        _log.info('Suite %s: %d files, %.1f MB of trace', name, len(parsed),
                  os.path.getsize(path) / 1e6)
        suites_by_path[name] = parsed

    log_union_check(check_union_equals_combined(combined_by_path, suites_by_path),
                    [name for name, _ in suite_lcov_paths])
    return [(name, line_totals(suites_by_path[name])) for name, _ in suite_lcov_paths]


def main(args):
    options = parse_args(args)
    logging.basicConfig(level=logging.DEBUG if options.verbose else logging.INFO,
                        format='%(levelname)s: %(message)s')

    host = Host()
    port = host.port_factory.get(options.platform, options)

    try:
        objects = instrumented_binary_paths(port, options.extra_objects,
                                            options.include_test_support, options.products)
    except RuntimeError as error:
        _log.error('%s', error)
        return 1
    if not objects:
        _log.error('Found no instrumented frameworks under %s.', port._build_path())
        _log.error('Build with --coverage first, or pass --build-directory.')
        return 1
    for path in objects:
        _log.info('Including %s', path)

    os.makedirs(options.output_dir, exist_ok=True)

    suites = []
    if options.suite:
        try:
            suites = resolve_suites(options.suite, options.output_dir)
        except (SuiteSpecError, RuntimeError) as error:
            _log.error('%s', error)
            return 1
        profile_path = merge_suite_profiles(
            suites, os.path.join(options.output_dir, 'coverage.profdata'))
        raw_profiles = [path for suite in suites for path in suite.raw_profiles]
    elif options.profdata:
        profile_path = options.profdata
        raw_profiles = []
        _log.info('Reporting from the already-indexed profile %s', profile_path)
    else:
        profile_path = os.path.join(options.output_dir, 'coverage.profdata')
        raw_profiles = merge_all_raw_profiles_in_directory(options.coverage_dir, profile_path)
        _log.info('Indexed %d raw profiles into %s', len(raw_profiles), profile_path)

    warn_about_objects_with_no_profile_data(objects, raw_profiles)

    ignore_regexes = list(DEFAULT_IGNORE_REGEXES) + list(options.ignore_regexes)
    if not options.include_third_party:
        ignore_regexes += list(THIRD_PARTY_IGNORE_REGEXES)
        copied = third_party_copied_header_ignore_regexes(port._build_path())
        if copied:
            _log.info('Excluding %d third-party copied-header directories the build installed: '
                      '%s', len(copied),
                      ', '.join(regex.rsplit('/', 1)[-1] for regex in copied))
            ignore_regexes += copied

    summary_path = os.path.join(options.output_dir, 'summary.txt')
    lcov_path = os.path.join(options.output_dir,
                             'coverage.lcov.gz' if options.compress_lcov else 'coverage.lcov')
    html_dir = os.path.join(options.output_dir, 'html')
    suite_lcov_paths = [
        (suite.name, os.path.join(options.output_dir, 'coverage-{}.lcov.gz'.format(suite.name)
                                  if options.compress_lcov else
                                  'coverage-{}.lcov'.format(suite.name)))
        for suite in suites] if len(suites) > 1 else []

    # These llvm-cov invocations are independent and each takes minutes over WebKit-sized
    # binaries, so run them at once rather than one after another. They are separate
    # processes; the threads here only wait on them. One more per suite, over the same objects
    # with a different profile.
    def make_summary():
        return LLVMCov.report(objects, profile_path, ignore_regexes, options.path_equivalence,
                              check_binary_ids=True)

    def make_lcov():
        return LLVMCov.export_lcov(objects, profile_path, lcov_path, ignore_regexes,
                                   options.path_equivalence, compress=options.compress_lcov)

    def make_html():
        return LLVMCov.show_html(objects, profile_path, html_dir, ignore_regexes,
                                 options.path_equivalence,
                                 show_instantiations=options.show_instantiations)

    def make_suite_lcov(suite_profile, output_path):
        return lambda: LLVMCov.export_lcov(objects, suite_profile, output_path, ignore_regexes,
                                           options.path_equivalence,
                                           compress=options.compress_lcov)

    work = {'summary': make_summary}
    # The directory index and the line views are both built from the lcov trace, so it is
    # needed even with --no-lcov.
    work['lcov'] = make_lcov
    if options.llvm_cov_html:
        work['html'] = make_html
    for suite, (_, suite_lcov_path) in zip(suites, suite_lcov_paths):
        work['lcov ' + suite.name] = make_suite_lcov(suite.profdata, suite_lcov_path)
    if len(suites) == 1:
        _log.info('One suite, so it needs no column of its own: the combined column is it.')

    _log.info('Running %d llvm-cov invocations concurrently: %s',
              len(work), ', '.join(sorted(work)))
    with ThreadPoolExecutor(max_workers=len(work)) as pool:
        futures = {name: pool.submit(function) for name, function in work.items()}
        results = {name: future.result() for name, future in futures.items()}

    for name, result in results.items():
        if result.returncode:
            _log.error('llvm-cov %s failed: %s', name, result.stderr)
            return 1

    # A profile collected from different binaries than the ones being reported on still
    # produces a complete-looking report: llvm-cov matches what it can, drops the rest, and
    # says so only on stderr. The numbers are then quietly wrong, and it is easy to cause by
    # simply rebuilding between running the tests and generating the report.
    #
    # The signal to use is llvm-cov's per-object "profile data may be out of date" warning.
    # Do NOT use its "N functions have mismatched data" count: some mismatch is expected and
    # harmless here, because WTF and bmalloc are statically linked into several frameworks, so
    # one function name legitimately has a different structural hash per image while
    # llvm-profdata merged those counters by name. A correct full report shows tens of
    # thousands of those.
    stale_objects = set()
    mismatched = 0
    for result in results.values():
        for line in (result.stderr or '').splitlines():
            match = re.search(r'warning: (.*): profile data may be out of date', line)
            if match:
                stale_objects.add(match.group(1))
            count = re.search(r'(\d+) functions have mismatched data', line)
            if count:
                mismatched = max(mismatched, int(count.group(1)))

    if mismatched:
        _log.info('%d functions have mismatched data. Some of that is expected: WTF and bmalloc '
                  'are linked into several frameworks, so the same function has a different hash '
                  'in each.', mismatched)

    if stale_objects:
        _log.error('These binaries are newer than the profile, so the report would be wrong:')
        for path in sorted(stale_objects):
            _log.error('    %s', path)
        _log.error('Re-run the tests against the current build, or pass --allow-profile-mismatch.')
        if not options.allow_profile_mismatch:
            return 1

    with open(summary_path, 'w') as summary_file:
        summary_file.write(results['summary'].stdout)
    for line in results['summary'].stdout.splitlines()[-3:]:
        print(line)
    _log.info('Wrote %s', summary_path)
    _log.info('Wrote %s (%.1f MB)', lcov_path, os.path.getsize(lcov_path) / 1e6)
    for name, path in suite_lcov_paths:
        _log.info('Wrote %s (%.1f MB), suite %s', path, os.path.getsize(path) / 1e6, name)

    # The third state. llvm-cov can tell a covered line from an instrumented-but-unexecuted
    # one, but a file this configuration never compiled has no coverage mapping at all, so it
    # is absent from the trace rather than present at 0%. On the measured macOS Release build
    # that is 2,446 of 10,473 first-party implementation files and 764,144 physical lines, so
    # without this the percentages above are quoted over 77% of the tree without saying so.
    #
    # It is the same in every suite's column, because every suite ran against the same
    # binaries, so it is reported once and not per suite.
    #
    # These files are deliberately not given synthetic 0% rows: 134 of them produced no
    # coverage mapping even though they were compiled, because there is nothing in them to
    # count -- wtf/ASCIICType.cpp is a lookup table -- so a 0% row would invent a denominator.
    absence = None
    if options.build_inventory:
        absence = summarize_absent_files(port, lcov_path, ignore_regexes, options.output_dir)

    thresholds = thresholds_from_options(options)
    totals = None
    combined_by_path = None
    if options.html or thresholds or suite_lcov_paths:
        # One parse of the combined trace, shared by the per-suite check, the gate and the
        # HTML. Parsing a full-suite trace takes longer than rendering all 16,149 line views
        # does, so doing it twice would be the most expensive thing in the report.
        canonicalizer = PathCanonicalizer(port.webkit_base(),
                                          build_directory=port._build_path())
        combined_by_path = parse_lcov(lcov_path, canonicalizer)
        if not combined_by_path:
            _log.error('%s contained no coverage records.', lcov_path)
            return 1
        canonicalizer.log_summary()
        totals = project_totals(combined_by_path)

    suite_line_totals = []
    if suite_lcov_paths:
        suite_line_totals = summarize_suites(port.webkit_base(), suite_lcov_paths,
                                             combined_by_path)

    if options.html:
        # A per-directory index plus one line-by-line view per file, both rendered from the
        # trace this run already has to parse. llvm-cov's own index lists every source file in
        # one 8MB page, and its per-file pages are 909MB of the report.
        report = write_report(lcov_path, options.output_dir, source_root=port.webkit_base(),
                              absence=absence, build_directory=port._build_path(),
                              index_link='html/index.html' if options.llvm_cov_html else None,
                              coverage_by_path=combined_by_path,
                              suite_line_totals=suite_line_totals)
        _log.info('Wrote %d directory pages and %d line views (%.1f MB); start at %s',
                  report.directory_pages, report.source_pages, report.source_bytes / 1e6,
                  os.path.join(options.output_dir, 'index.html'))
        if options.llvm_cov_html:
            _log.info('Wrote %s', os.path.join(html_dir, 'index.html'))

    if not options.lcov:
        os.unlink(lcov_path)
        for _, path in suite_lcov_paths:
            os.unlink(path)

    if not options.keep_raw_profiles:
        for path in raw_profiles:
            os.unlink(path)
        _log.info('Deleted %d raw profiles', len(raw_profiles))

    # Last, and only after everything has been written: a failed gate must leave the report
    # behind, because the report is how somebody works out why it fired.
    if thresholds:
        return check_absolute_thresholds(thresholds, totals)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
