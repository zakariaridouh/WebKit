#include? "../../Internal/Configurations/HaveInternalSDK.xcconfig"
#include? "<DEVELOPER_DIR>/AppleInternal/XcodeConfig/PlatformSupport.xcconfig"
#include "Sanitizers.xcconfig"
#include "SDKVariant.xcconfig"
#include "WebKitProjectPaths.xcconfig"
#include "SDKAdditions.xcconfig"

WK_ENABLE_SLOW_BUILD_VERIFICATION = $(WK_ENABLE_SLOW_BUILD_VERIFICATION_$(CONFIGURATION));
WK_ENABLE_SLOW_BUILD_VERIFICATION_Production = YES;
__ALLOW_EXCLUDED_USER_SCRIPT_SANDBOXING_PHASE_NAMES = YES;

// Prefix Definitions
//
// WK_COMMON_ prefix is used to define variables in CommonBase.xcconfig
// that may be used in project xcconfig files when $(inherited) is not
// used.
// Examples: WK_COMMON_OTHER_{CFLAGS,CPLUSPLUSFLAGS,LDFLAGS}.
//
// WK_DEFAULT_ prefix is used in Base.xcconfig project files for
// single-value variables that may be overridden in CommonBase.xcconfig.
// Example: WK_DEFAULT_GCC_OPTIMIZATION_LEVEL.

GCC_OPTIMIZATION_LEVEL = $(WK_GCC_OPTIMIZATION_LEVEL_SANITIZER_OVERRIDE_$(WK_ANY_SANITIZER_ENABLED));
WK_GCC_OPTIMIZATION_LEVEL_SANITIZER_OVERRIDE_NO = $(WK_DEFAULT_GCC_OPTIMIZATION_LEVEL);
WK_GCC_OPTIMIZATION_LEVEL_SANITIZER_OVERRIDE_YES = $(WK_SANITIZER_GCC_OPTIMIZATION_LEVEL);

WK_OS_UNFAIR_LOCK_INLINE_CFLAGS = $(WK_OS_UNFAIR_LOCK_INLINE_CFLAGS_$(USE_INTERNAL_SDK));
WK_OS_UNFAIR_LOCK_INLINE_CFLAGS_YES = OS_UNFAIR_LOCK_INLINE=1;

WK_ENGINEERING_BUILD = $(WK_ENGINEERING_BUILD_$(CONFIGURATION));
WK_ENGINEERING_BUILD_Debug = 1;
WK_ENGINEERING_BUILD_Release = 1;
WK_ENGINEERING_BUILD_Production = 0;

// ENABLE_LLVM_COVERAGE must reach clang and the sandbox profile preprocessing, so it is defined
// here once rather than per project.
ENABLE_LLVM_COVERAGE_DEFINES = $(ENABLE_LLVM_COVERAGE_DEFINES_$(ENABLE_LLVM_COVERAGE));
ENABLE_LLVM_COVERAGE_DEFINES_YES = ENABLE_LLVM_COVERAGE=1;

WK_GCC_PREPROCESSOR_DEFINITIONS = $(WK_GCC_PREPROCESSOR_DEFINITIONS_$(USE_INTERNAL_SDK)) ENGINEERING_BUILD=$(WK_ENGINEERING_BUILD) $(WK_PRESERVE_MOST_DEFINES) $(ENABLE_LLVM_COVERAGE_DEFINES);
WK_GCC_PREPROCESSOR_DEFINITIONS_YES = $(WK_OS_UNFAIR_LOCK_INLINE_CFLAGS) __ASSERT_MACROS_DEFINE_VERSIONS_WITHOUT_UNDERSCORES=0;
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(WK_GCC_PREPROCESSOR_DEFINITIONS);

// PRESERVE_MOST is only profitable under LTO: without it, hot/cold splitting gives the extracted
// cold region the default calling convention, so the preserve_most parent saves X9-X15 on its hot
// path. See rdar://183555125.
WK_PRESERVE_MOST_DEFINES = $(WK_PRESERVE_MOST_DEFINES_$(LLVM_LTO));
WK_PRESERVE_MOST_DEFINES_YES = HAVE_PRESERVE_MOST=1;
WK_PRESERVE_MOST_DEFINES_YES_THIN = HAVE_PRESERVE_MOST=1;

// -fwrapv: Make signed integer overflow two's compliment rather than UB.
WK_COMMON_OTHER_CFLAGS = -fwrapv $(WK_AVAILABILITY_OVERLAY_FLAGS) $(WK_SANITIZER_OTHER_CFLAGS) $(WK_COMMON_OTHER_CFLAGS_CLANG_PGO_$(WK_OR_$(WK_ENABLE_CLANG_PGO_USE)_$(ENABLE_LLVM_PROFILE_GENERATION)));
// Work around rdar://141760829 until the fix is available on all clang-1700
// based toolchains.
// Fix from rdar://178983382 to avoid symbol module prefix differences causing performance loss.
WK_COMMON_OTHER_CFLAGS_CLANG_PGO_YES = -mllvm -system-headers-coverage -mllvm -static-func-full-module-prefix=false;

// Makes clang emit a weak __llvm_profile_filename for every instrumented image. The five
// hand-written strong definitions still win. Must precede the opt-out flags below: clang is last-wins.
//
// Only macOS and simulators get a directory: a simulator shares /private/tmp with the host.
// A device has none.
WK_COVERAGE_PROFILE_DIRECTORY = $(WK_COVERAGE_PROFILE_DIRECTORY_$(WK_PLATFORM_NAME));
WK_COVERAGE_PROFILE_DIRECTORY_macosx = /private/tmp/WebKitCoverage;
WK_COVERAGE_PROFILE_DIRECTORY_iphonesimulator = /private/tmp/WebKitCoverage;
WK_COVERAGE_PROFILE_DIRECTORY_watchsimulator = /private/tmp/WebKitCoverage;
WK_COVERAGE_PROFILE_DIRECTORY_appletvsimulator = /private/tmp/WebKitCoverage;
WK_COVERAGE_PROFILE_DIRECTORY_xrsimulator = /private/tmp/WebKitCoverage;
WK_HAVE_COVERAGE_PROFILE_DIRECTORY = $(WK_NOT_$(WK_EMPTY_$(WK_COVERAGE_PROFILE_DIRECTORY)));

WK_COVERAGE_PROFILE_PATH_CFLAGS = $(WK_COVERAGE_PROFILE_PATH_CFLAGS_$(ENABLE_LLVM_COVERAGE)_$(WK_HAVE_COVERAGE_PROFILE_DIRECTORY));
WK_COVERAGE_PROFILE_PATH_CFLAGS_YES_YES = -fprofile-instr-generate=$(WK_COVERAGE_PROFILE_DIRECTORY)/$(PRODUCT_NAME)_%8m%c.profraw;

// A project opts out of coverage with WK_DEFAULT_COVERAGE_OPT_OUT = YES. Exactly YES: any other
// value is silently ignored. The -fno- forms win because clang is last-wins and OTHER_CFLAGS
// follows CLANG_COVERAGE_MAPPING.
WK_COMMON_COVERAGE_OPT_OUT_CFLAGS = $(WK_COMMON_COVERAGE_OPT_OUT_CFLAGS_$(ENABLE_LLVM_COVERAGE)_$(WK_DEFAULT_COVERAGE_OPT_OUT));
WK_COMMON_COVERAGE_OPT_OUT_CFLAGS_YES_YES = -fno-profile-instr-generate -fno-coverage-mapping;

OTHER_CFLAGS = $(inherited) $(WK_COMMON_OTHER_CFLAGS) $(WK_COVERAGE_PROFILE_PATH_CFLAGS) $(WK_COMMON_COVERAGE_OPT_OUT_CFLAGS);

WK_COMMON_OTHER_CPLUSPLUSFLAGS = $(WK_AVAILABILITY_OVERLAY_FLAGS) $(WK_LIBCPP_ASSERTIONS_CFLAGS);
OTHER_CPLUSPLUSFLAGS = $(inherited) $(WK_COMMON_OTHER_CPLUSPLUSFLAGS);

_EXPERIMENTAL_SWIFT_EXPLICIT_MODULES = YES;

WK_DEFAULT_COMPILATION_CACHE_ENABLE_CACHING = YES;
COMPILATION_CACHE_ENABLE_CACHING = $(WK_DEFAULT_COMPILATION_CACHE_ENABLE_CACHING);

FUSE_BUILD_SCRIPT_PHASES = YES;

// PGO and coverage both need the section rename below, and neither can be built with -fprofile-use=.
WK_ANY_LLVM_INSTRUMENTATION_ENABLED = $(WK_OR_$(ENABLE_LLVM_PROFILE_GENERATION)_$(ENABLE_LLVM_COVERAGE));

WK_COMMON_OTHER_LDFLAGS = $(WK_SANITIZER_OTHER_LDFLAGS) $(WK_COMMON_OTHER_LDFLAGS_INSTRUMENTATION_$(WK_ANY_LLVM_INSTRUMENTATION_ENABLED));
// Work around rdar://151083138 by moving the section the profiling runtime
// mmaps to its own segment.
// -fprofile-generate here (rather than on OTHER_CFLAGS) exists solely to make
// clang auto-link the LLVM profiling runtime.
WK_COMMON_OTHER_LDFLAGS_INSTRUMENTATION_YES = -Wl,-rename_section,__DATA,__llvm_prf_cnts,__MMAP_DATA,__llvm_prf_cnts -fprofile-generate;
OTHER_LDFLAGS = $(inherited) $(WK_COMMON_OTHER_LDFLAGS);

WK_COMMON_OTHER_TAPI_FLAGS = -x objective-c++ -std=c++2b -fno-rtti $(WK_SANITIZER_OTHER_TAPI_FLAGS) $(WK_AVAILABILITY_OVERLAY_FLAGS);
OTHER_TAPI_FLAGS = $(inherited) $(WK_COMMON_OTHER_TAPI_FLAGS);

WK_DEFAULT_WK_AUDIT_SPI[sdk=iphoneos*] = $(WK_NOT_$(WK_ANY_SANITIZER_ENABLED));
// Explicitly disable auditing on other embedded platforms, because some SDKs
// fall back to reading settings for iOS.
WK_DEFAULT_WK_AUDIT_SPI[sdk=appletvos*] = ;
WK_DEFAULT_WK_AUDIT_SPI[sdk=watchos*] = ;
WK_DEFAULT_WK_AUDIT_SPI[sdk=xros*] = ;
// Disable auditing on internal builds of already-shipped releases.
WK_DEFAULT_WK_AUDIT_SPI[sdk=iphoneos26*.internal] = ;

// Overridden in projects which do not have an InstallAPI requirement to
// support audit-spi (e.g. WebCore).
WK_AUDIT_SPI = $(WK_AND_$(WK_DEFAULT_WK_AUDIT_SPI)_$(SUPPORTS_TEXT_BASED_API));

WK_OTHER_AUDIT_SPI_FLAGS = $(WK_OTHER_AUDIT_SPI_FLAGS_148943382) $(WK_OTHER_AUDIT_SPI_FLAGS_164901718) $(WK_OTHER_AUDIT_SPI_FLAGS_$(CONFIGURATION));
WK_OTHER_AUDIT_SPI_FLAGS_Release = -DNDEBUG;
WK_OTHER_AUDIT_SPI_FLAGS_Production = -DNDEBUG;
WK_OTHER_AUDIT_SPI_FLAGS_148943382[sdk=iphoneos26.2.internal] = -DSDKDB_HAS_148943382;
WK_OTHER_AUDIT_SPI_FLAGS_148943382[sdk=iphoneos26.3.internal] = -DSDKDB_HAS_148943382;
WK_OTHER_AUDIT_SPI_FLAGS_164901718[sdk=iphoneos26.*.internal] = -DSDKDB_HAS_164901718;

GCC_WARN_NON_VIRTUAL_DESTRUCTOR = YES;
GCC_THREADSAFE_STATICS = YES;

WK_COMMON_WARNING_CFLAGS = -Wall -Wc99-designator -Wconditional-uninitialized -Wextra -Wdeprecated-enum-enum-conversion -Wdeprecated-enum-float-conversion -Wenum-float-conversion -Wfinal-dtor-non-final-class -Wformat=2 -Wmisleading-indentation -Wpointer-to-int-cast -Wreorder-init-list -Wundef -Wunused-but-set-variable -Wvla -Werror=unguarded-availability -Wthread-safety;
WARNING_CFLAGS = $(inherited) $(WK_COMMON_WARNING_CFLAGS) $(WK_SANITIZER_WARNING_CFLAGS);

CLANG_CXX_STANDARD_LIBRARY_HARDENING = extensive;

SWIFT_VERSION = 6.0;

SWIFT_OPTIMIZATION_LEVEL = -O;
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone;

// Enable strict memory safety in Swift.
WK_SWIFT_MEMORY_SAFETY_FLAGS = -strict-memory-safety -enable-experimental-feature Lifetimes -enable-experimental-feature LifetimeDependence -enable-experimental-feature ImportNonPublicCxxMembers;

// Treat memory safety warnings as errors.
WK_SWIFT_MEMORY_SAFETY_ERROR_FLAGS = -Werror StrictMemorySafety -Werror ForeignReferenceType -Werror RegionIsolation;
// rdar://164903024: Work around false positives in some SDK versions.
WK_SWIFT_MEMORY_SAFETY_ERROR_FLAGS[sdk=*26.3*] = ;

// Treat VariableNeverMutated warnings as errors only with SDKs that ship Swift 6.4 or later. Swift 6.3
// needs `var` bindings in some places to work around rdar://170907318.
WK_SWIFT_VARIABLE_NEVER_MUTATED_ERROR_FLAGS = -Werror VariableNeverMutated;
WK_SWIFT_VARIABLE_NEVER_MUTATED_ERROR_FLAGS[sdk=*26.*] = ;

// Treat UnusedImportAccess warnings as errors only with SDKs that ship Swift 6.4 or later. Swift 6.3
// doesn't support the `@diagnose` attribute used to suppress existing violations.
WK_SWIFT_UNUSED_IMPORT_ACCESS_ERROR_FLAGS = -Werror UnusedImportAccess;
WK_SWIFT_UNUSED_IMPORT_ACCESS_ERROR_FLAGS[sdk=*26.*] = ;

// rdar://168992837 requires us to tell swiftc to tell clang how to set version macros
// when interpreting C++ headers as clang modules, so that we get identical feature
// enablement to C++ interpretation of those headers (otherwise we get mismatched data members etc.)
WK_SWIFT_CLANG_DEPLOYMENT_TARGET = $(WK_SWIFT_CLANG_DEPLOYMENT_TARGET_$(WK_PLATFORM_NAME));
WK_SWIFT_CLANG_DEPLOYMENT_TARGET_macosx = -clang-target $(CURRENT_ARCH)-apple-macos$(MACOSX_DEPLOYMENT_TARGET);

// CLANG_COVERAGE_MAPPING only reaches clang; swiftc needs its own flags.
WK_COVERAGE_OTHER_SWIFT_FLAGS = $(WK_COVERAGE_OTHER_SWIFT_FLAGS_$(ENABLE_LLVM_COVERAGE)_$(WK_DEFAULT_COVERAGE_OPT_OUT));
WK_COVERAGE_OTHER_SWIFT_FLAGS_YES_ = -profile-generate -profile-coverage-mapping;
WK_COVERAGE_OTHER_SWIFT_FLAGS_YES_NO = -profile-generate -profile-coverage-mapping;

// rdar://170129992: remove -track-system-dependencies when resolved
// FIXME(rdar://189511928, rdar://189512247): remove -disable-round-trip-debug-types when both are resolved
OTHER_SWIFT_FLAGS = $(inherited) $(WK_AVAILABILITY_OVERLAY_SWIFT_FLAGS) -Xcc -fvisibility=hidden -Werror ExistentialAny -Werror NoUseUnstructuredThrowingTask -Werror NoUsage $(WK_SWIFT_VARIABLE_NEVER_MUTATED_ERROR_FLAGS) $(WK_SWIFT_UNUSED_IMPORT_ACCESS_ERROR_FLAGS) -enable-upcoming-feature ExistentialAny $(WK_SWIFT_MEMORY_SAFETY_FLAGS) $(WK_SWIFT_MEMORY_SAFETY_ERROR_FLAGS) $(WK_SWIFT_CLANG_DEPLOYMENT_TARGET) $(WK_SANITIZER_OTHER_SWIFT_FLAGS) $(WK_COVERAGE_OTHER_SWIFT_FLAGS) -enable-upcoming-feature InternalImportsByDefault -enable-upcoming-feature MemberImportVisibility -track-system-dependencies -enable-experimental-feature ImportCxxMembersLazily -enable-experimental-feature SuppressedAssociatedTypes -enable-experimental-feature SuppressedAssociatedTypesWithDefaults -enable-experimental-feature ForeignReferenceTypeInheritance -Xfrontend -disable-round-trip-debug-types -enable-experimental-feature SafeInteropWrappers;

OTHER_LIBTOOLFLAGS = -no_warning_for_no_symbols;
